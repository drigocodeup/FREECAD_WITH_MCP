# Reference only. Entry points read process environment; this file is NOT loaded automatically.
FREECAD_MCP_HOST=127.0.0.1
FREECAD_MCP_PORT=8765
FREECAD_MCP_AUTH_MODE=bearer
# Generate a random token locally. Do not commit real credentials.
FREECAD_MCP_TOKEN=
# Optional exact Host/Origin allow lists, comma separated. No wildcards.
# FREECAD_MCP_ALLOWED_HOSTS=127.0.0.1:8765,localhost:8765
# FREECAD_MCP_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
# Non-loopback binding requires deliberate opt-in; no firewall rules are changed.
# FREECAD_MCP_ALLOW_NON_LOOPBACK=1
# OAuth mode: existing external issuer handles login, consent, PKCE and client registration.
# FREECAD_MCP_AUTH_MODE=oauth
# FREECAD_MCP_OAUTH_ISSUER=https://issuer.example.invalid
# FREECAD_MCP_OAUTH_JWKS_URL=https://issuer.example.invalid/.well-known/jwks.json
# FREECAD_MCP_RESOURCE_URL=https://resource.example.invalid/mcp
# FREECAD_MCP_OAUTH_AUDIENCE=https://resource.example.invalid/mcp
# FREECAD_MCP_REQUIRED_SCOPES=freecad:control
# Tunnel prerequisites (not auto-started):
# FREECAD_TUNNEL_CLIENT=C:/path/to/tunnel-client.exe
# CONTROL_PLANE_API_KEY=<local environment only>
